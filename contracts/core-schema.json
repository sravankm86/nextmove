{
  "version": 7,
  "description": "Six-table logical blueprint, not raw connector request payloads. Map and preserve existing fields by ID; computed metadata never receives input values. TRACKER.md defines compact displays, manual feedback and view visibility.",
  "tables": [
    {
      "name": "Companies",
      "business_key": "Company key",
      "description": "Explicit company choices and confirmed simple quota/cooldown rules. Complex unclear rules block submission; no automatic Allow.",
      "fields": [
        {
          "name": "Company",
          "type": "singleLineText"
        },
        {
          "name": "Company key",
          "type": "singleLineText"
        },
        {
          "name": "Search status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Allow"
              },
              {
                "name": "Exclude"
              }
            ]
          }
        },
        {
          "name": "Pool",
          "type": "singleLineText"
        },
        {
          "name": "Notes",
          "type": "multilineText"
        },
        {
          "name": "Max applications",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Application window (days)",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Application window type",
          "type": "singleLineText"
        },
        {
          "name": "Rejection cooldown (days)",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Restriction scope",
          "type": "singleLineText"
        },
        {
          "name": "Apply blocked until",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Application hold status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Not assessed"
              },
              {
                "name": "No known hold"
              },
              {
                "name": "Held"
              },
              {
                "name": "Needs clarification"
              }
            ]
          }
        },
        {
          "name": "Restriction details / source",
          "type": "multilineText"
        },
        {
          "name": "Last rejection date",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Restriction last verified",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Restriction timezone",
          "type": "singleLineText"
        }
      ]
    },
