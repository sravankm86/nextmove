{
  "version": 19,
  "description": "Nine-table logical blueprint; reactivate answer tables without deleting existing data; preserve other legacy fields/tables as read-only history, not raw connector request payloads. Map and preserve existing fields by ID; computed metadata never receives input values. DATA.md defines compact displays, manual feedback and view visibility.",
  "tables": [
    {
      "name": "Companies",
      "business_key": "Company key",
      "description": "Human targeting, agent-discovered Proposed companies, funding and company evidence. No automatic Allow.",
      "fields": [
        {
          "name": "Company",
          "type": "singleLineText"
        },
        {
          "name": "Company key",
          "type": "singleLineText"
        },
        {
          "name": "Search status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Proposed"
              },
              {
                "name": "Allow"
              },
              {
                "name": "Exclude"
              }
            ]
          }
        },
        {
          "name": "Manual notes",
          "type": "multilineText"
        },
        {
          "name": "Feedback",
          "type": "multilineText"
        },
        {
          "name": "Agent notes",
          "type": "multilineText"
        },
        {
          "name": "Funding stage",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Pre-seed / Seed"
              },
              {
                "name": "Series A"
              },
              {
                "name": "Series B"
              },
              {
                "name": "Series C"
              },
              {
                "name": "Series D"
              },
              {
                "name": "Series E+"
              },
              {
                "name": "Late private"
              },
              {
                "name": "Public"
              },
              {
                "name": "Unknown"
              }
            ]
          }
        },
        {
          "name": "Company evidence",
          "type": "url"
        }
      ]
    },
    {
      "name": "Applications",
      "business_key": "Canonical Job key; native record ID for preserved unmatched history",
      "description": "27 physical fields including relationships. Current job facts, six-state lifecycle, human/agent notes and resume readiness references live here; bounded stage snapshots in History join fixed shared inputs in Runs under DATA.md.",
      "fields": [
        {
          "name": "Application ID",
          "type": "formula",
          "options": {
            "formula": "RECORD_ID()"
          }
        },
        {
          "name": "Role",
          "type": "singleLineText"
        },
        {
          "name": "Job key",
          "type": "singleLineText"
        },
        {
          "name": "Job description link",
          "type": "url"
        },
        {
          "name": "Lifecycle status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Inventoried"
              },
              {
                "name": "Need review"
              },
              {
                "name": "Queued"
              },
              {
                "name": "Ready"
              },
              {
                "name": "Not pursuing"
              },
              {
                "name": "Duplicate"
              }
            ]
          }
        },
        {
          "name": "Manual notes",
          "type": "multilineText"
        },
        {
          "name": "Feedback",
          "type": "multilineText"
        },
        {
          "name": "Starting salary",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Max salary",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Additional compensation",
          "type": "multipleSelects",
          "options": {
            "choices": [
              {
                "name": "Equity"
              },
              {
                "name": "Bonus"
              },
              {
                "name": "Commission"
              },
              {
                "name": "Bonus or commission"
              },
              {
                "name": "Not stated"
              }
            ]
          }
        },
        {
          "name": "Location",
          "type": "singleLineText"
        },
        {
          "name": "Work arrangement",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Remote"
              },
              {
                "name": "Hybrid"
              },
              {
                "name": "On-site"
              },
              {
                "name": "Unspecified"
              }
            ]
          }
        },
        {
          "name": "Job posted date",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Role eligibility",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Pending"
              },
              {
                "name": "Eligible"
              },
              {
                "name": "Excluded"
              }
            ]
          }
        },
        {
          "name": "Career fit",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "High"
              },
              {
                "name": "Medium"
              },
              {
                "name": "Low"
              },
              {
                "name": "Unresolved"
              }
            ]
          }
        },
        {
          "name": "Resume fit",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "High"
              },
              {
                "name": "Medium"
              },
              {
                "name": "Low"
              },
              {
                "name": "Unresolved"
              }
            ]
          }
        },
        {
          "name": "Agent notes",
          "type": "multilineText"
        },
        {
          "name": "Job evidence",
          "type": "url"
        },
        {
          "name": "Resume link",
          "type": "url"
        },
        {
          "name": "Resume version",
          "type": "singleLineText"
        },
        {
          "name": "Resume verified at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        }
      ]
    },
    {
      "name": "Sources",
