{
  "version": 10,
  "description": "Six-table logical blueprint, not raw connector request payloads. Map and preserve existing fields by ID; computed metadata never receives input values. DATA.md defines compact displays, manual feedback and view visibility.",
  "tables": [
    {
      "name": "Companies",
      "business_key": "Company key",
      "description": "Explicit company choices and confirmed simple quota/cooldown rules. Complex unclear rules block submission; no automatic Allow.",
      "fields": [
        {
          "name": "Company",
          "type": "singleLineText"
        },
        {
          "name": "Company key",
          "type": "singleLineText"
        },
        {
          "name": "Search status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Allow"
              },
              {
                "name": "Exclude"
              }
            ]
          }
        },
        {
          "name": "Notes",
          "type": "multilineText"
        },
        {
          "name": "Max applications",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Application window (days)",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Application window type",
          "type": "singleLineText"
        },
        {
          "name": "Rejection cooldown (days)",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Restriction scope",
          "type": "singleLineText"
        },
        {
          "name": "Apply blocked until",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Application hold status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Not assessed"
              },
              {
                "name": "No known hold"
              },
              {
                "name": "Held"
              },
              {
                "name": "Needs clarification"
              }
            ]
          }
        },
        {
          "name": "Restriction details / source",
          "type": "multilineText"
        },
        {
          "name": "Restriction timezone",
          "type": "singleLineText"
        }
      ],
      "common_fields": []
    },
    {
      "name": "Applications",
      "business_key": "Canonical Job key; native record ID for preserved unmatched history",
      "description": "29 physical fields including relationships. Current job facts, nine-state lifecycle, human/agent notes and readiness references live here; bounded stage snapshots in History join fixed shared inputs in Runs under DATA.md.",
      "fields": [
        {
          "name": "Application ID",
          "type": "formula",
          "options": {
            "formula": "RECORD_ID()"
          }
        },
        {
          "name": "Role",
          "type": "singleLineText"
        },
        {
          "name": "Job key",
          "type": "singleLineText"
        },
        {
          "name": "Job description link",
          "type": "url"
        },
        {
          "name": "Lifecycle status",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Inventoried"
              },
              {
                "name": "Needs attention"
              },
              {
                "name": "Queued"
              },
              {
                "name": "Ready"
              },
              {
                "name": "Applied"
              },
              {
                "name": "Interviewing"
              },
              {
                "name": "Not pursuing"
              },
              {
                "name": "Rejected"
              },
              {
                "name": "Duplicate"
              }
            ]
          }
        },
        {
          "name": "Manual notes",
          "type": "multilineText"
        },
        {
          "name": "Starting salary",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Max salary",
          "type": "number",
          "options": {
            "precision": 0
          }
        },
        {
          "name": "Additional compensation",
          "type": "multipleSelects",
          "options": {
            "choices": [
              {
                "name": "Equity"
              },
              {
                "name": "Bonus"
              },
              {
                "name": "Commission"
              },
              {
                "name": "Bonus or commission"
              },
              {
                "name": "Not stated"
              }
            ]
          }
        },
        {
          "name": "Location",
          "type": "singleLineText"
        },
        {
          "name": "Work arrangement",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Remote"
              },
              {
                "name": "Hybrid"
              },
              {
                "name": "On-site"
              },
              {
                "name": "Unspecified"
              }
            ]
          }
        },
        {
          "name": "Job posted date",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Role eligibility",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Pending"
              },
              {
                "name": "Eligible"
              },
              {
                "name": "Excluded"
              }
            ]
          }
        },
        {
          "name": "Career fit",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "High"
              },
              {
                "name": "Medium"
              },
              {
                "name": "Low"
              },
              {
                "name": "Unresolved"
              }
            ]
          }
        },
        {
          "name": "Resume fit",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "High"
              },
              {
                "name": "Medium"
              },
              {
                "name": "Low"
              },
              {
                "name": "Unresolved"
              }
            ]
          }
        },
        {
          "name": "Agent notes",
          "type": "multilineText"
        },
        {
          "name": "Job evidence",
          "type": "url"
        },
        {
          "name": "Resume link",
          "type": "url"
        },
        {
          "name": "Resume version",
          "type": "singleLineText"
        },
        {
          "name": "Resume verified at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Submission attempt key",
          "type": "singleLineText"
        },
        {
          "name": "Applied on",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "iso"
            }
          }
        },
        {
          "name": "Confirmation reference",
          "type": "multilineText"
        }
      ],
      "common_fields": []
    },
    {
      "name": "Sources",
      "business_key": "Source key",
      "description": "One official board/region. Enumerate all pages transiently; preserve coverage and minimal source/identity checks; plausible role/scope ambiguities are inventoried for Review.",
