        },
        {
          "name": "Region",
          "type": "singleLineText"
        },
        {
          "name": "Reader",
          "type": "singleLineText"
        },
        {
          "name": "Reader version",
          "type": "singleLineText"
        },
        {
          "name": "Latest coverage",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Complete"
              },
              {
                "name": "Partial"
              },
              {
                "name": "Failed"
              },
              {
                "name": "Unverified"
              }
            ]
          }
        },
        {
          "name": "Checkpoint (JSON)",
          "type": "multilineText"
        },
        {
          "name": "Last error",
