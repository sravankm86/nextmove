          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        }
      ],
      "common_fields": []
    },
    {
      "name": "Runs",
      "business_key": "Run key",
      "description": "One row per full run by default; manual stage invocations use the identical checkpoint/handoff shape. No per-job work-item or general attempt tables.",
