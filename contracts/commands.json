    },
    {
      "command": "Review",
      "aliases": [
        "review",
        "assess",
        "role fit",
        "shortlist"
      ],
      "stage": "Review",
      "mode": "prepare",
      "instructions": "stages/review.md",
      "scope": "All Queued plus explicitly retryable review-owned pre-submission records; preserve later states",
      "required_resources": [
        "instructions_repository",
        "structured_store",
        "career_goals",
        "master_resume",
        "job_description_content"
      ],
      "outputs": [
        "Applications",
        "Lifecycle Events"
      ],
