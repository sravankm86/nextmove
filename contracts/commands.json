  "resume_policy": "Resume one compatible released unfinished run of the same stage. Multiple candidates or ambiguous prior owner require disambiguation. Never steal an active owner on expiry alone.",
  "complete_rule": "Every frozen work item accounted for; acceptance/readback, audit and handoff persisted; unresolved work prevents Complete",
  "application_submission_default": false
}
