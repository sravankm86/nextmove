    "Stage Runs",
    "Work Items",
    "Task Attempts",
    "Artifacts"
  ],
  "commands": [
    {
      "command": "Scan",
      "aliases": [
        "scan",
        "scanner"
      ],
      "stage": "Scan",
      "mode": "prepare",
      "instructions": "stages/scan.md",
      "scope": "All current Allow companies and all verified configured official sources/regions; Exclude wins",
      "required_resources": [
        "instructions_repository",
        "structured_store",
        "career_goals",
        "job_description_content"
