      "required_resources": [
        "instructions_repository",
        "structured_store",
        "master_resume",
        "resume_output"
      ],
      "outputs": [
        "Applications",
        "Artifacts",
        "Lifecycle Events"
      ],
      "next_command": "Apply"
    },
    {
      "command": "Apply",
      "aliases": [
        "apply",
        "applier"
      ],
      "stage": "Apply",
      "mode": "review",
      "instructions": "stages/apply.md",
