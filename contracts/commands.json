      "outputs": [
        "Applications",
        "Task Attempts",
        "Artifacts",
        "Lifecycle Events"
      ],
      "next_command": "Track"
    },
    {
      "command": "Track",
      "aliases": [
        "track",
        "tracker"
      ],
      "stage": "Track",
      "mode": "prepare",
      "instructions": "stages/track.md",
      "scope": "Configured read-only mailbox checkpoint with overlap/pagination; exact-role event matching",
      "required_resources": [
        "instructions_repository",
        "structured_store",
        "mailbox"
      ],
      "outputs": [
        "Applications",
        "Mail Audit",
        "Lifecycle Events"
      ],
      "next_command": null
    }
