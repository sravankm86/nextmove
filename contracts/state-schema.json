{
  "version": 1,
  "description": "Logical schema. Resolve private table and field IDs at runtime. Cardinality is writer-validated, not a SQL constraint.",
  "tables": [
    {
      "name": "Context Registry",
      "description": "Private durable resource directory for fresh harness sessions. Content remains in Drive; this table holds reference, required-stage, version and verification state. No credentials.",
      "fields": [
        {
          "name": "Resource key",
          "type": "singleLineText"
        },
        {
          "name": "Resource name",
          "type": "singleLineText"
        },
        {
          "name": "Reference URL",
          "type": "url"
        },
        {
          "name": "Value (JSON)",
          "type": "multilineText"
        },
        {
          "name": "Required by",
          "type": "multilineText"
        },
        {
          "name": "Version / hash",
          "type": "singleLineText"
        },
        {
          "name": "Verification",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Located"
              },
              {
                "name": "Verified"
              },
              {
                "name": "Missing"
              },
              {
                "name": "Needs verification"
              },
              {
                "name": "Inaccessible"
              }
            ]
          }
        },
        {
          "name": "Verified at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Notes",
          "type": "multilineText"
        },
        {
          "name": "Created at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Updated at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        }
      ]
    },
    {
      "name": "Stage Config",
      "description": "One row per portable stage command. Instructions and queue contract are versioned in GitHub; private defaults and resource requirements live here. No automatic cross-stage execution.",
      "fields": [
        {
          "name": "Command",
          "type": "singleLineText"
        },
        {
          "name": "Stage",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Scan"
              },
              {
                "name": "Review"
              },
              {
                "name": "Prepare"
              },
              {
                "name": "Apply"
              },
              {
                "name": "Track"
              }
            ]
          }
        },
        {
          "name": "Default mode",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "review"
              },
              {
                "name": "prepare"
              },
              {
                "name": "auto-apply"
              }
            ]
          }
        },
        {
          "name": "Instructions path",
          "type": "singleLineText"
        },
        {
          "name": "Queue contract (JSON)",
          "type": "multilineText"
        },
        {
          "name": "Required resources (JSON)",
          "type": "multilineText"
        },
        {
          "name": "Policy (JSON)",
          "type": "multilineText"
        },
        {
          "name": "Readiness",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Configured"
              },
              {
                "name": "Needs capability check"
              },
              {
                "name": "Blocked"
              }
            ]
          }
        },
        {
          "name": "Blockers",
          "type": "multilineText"
        },
        {
          "name": "Created at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        },
        {
          "name": "Updated at",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "iso"
            },
            "timeFormat": {
              "name": "24hour"
            },
            "timeZone": "utc"
          }
        }
      ]
    },
